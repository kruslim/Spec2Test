__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/
.env

# Claude Code: personal settings and the desktop app's worktrees stay local;
# .claude/settings.json, skills and hooks are shared.
.claude/settings.local.json
CLAUDE.local.md
.claude/worktrees/

# Corpus documents are never committed; only the manifest and README are.
corpora/*
!corpora/manifest.toml
!corpora/README.md

# Eval runs: report.html and results.json per run.
eval-reports/

# Review logs store the whole source document; they never go in git.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Gold sets for documents that stay out of git (corpora/manifest.toml, licence).
gold/unece-r158.*
gold/fsae-rules.*
# Their judge calibration samples quote the source too (`calibrate sample --out`).
gold/judge/unece-r158.*
gold/judge/fsae-rules.*
